# systemd unit — copy to /etc/systemd/system/vajeyar-bot.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now vajeyar-bot
[Unit]
Description=DanaFox Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vajeyar
WorkingDirectory=/opt/vajeyar-bot
ExecStart=/opt/vajeyar-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
