# ───────────── DanaFox Telegram bot ─────────────
# Token from @BotFather  (required)
BOT_TOKEN=123456789:AA...your-token...

# Telegram user IDs allowed to use /admin and /broadcast (comma separated). Get yours from @userinfobot
ADMIN_IDS=

# Default language for new users: fa | en
DEFAULT_LANG=fa
# Default time zone for reminders (IANA name)
DEFAULT_TZ=Asia/Tehran

# SQLite database file
DB_PATH=./vajeyar.db

# Optional proxy if Telegram is blocked on your server, e.g.
#   socks5://127.0.0.1:1080   or   http://user:pass@host:port
PROXY=

# Optional Mini App (the full web app inside Telegram). Must be an HTTPS URL.
WEBAPP_URL=
# Serve ./webapp from this bot process (put Nginx/Caddy with HTTPS in front of it)
SERVE_WEBAPP=false
WEBAPP_PORT=8080

# Animated message effects (🎉 on finishing a session / perfect quiz)
USE_EFFECTS=true
LOG_LEVEL=INFO
