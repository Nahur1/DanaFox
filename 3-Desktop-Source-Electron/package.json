{
  "name": "vajeyar",
  "productName": "VajeYar",
  "version": "3.1.0",
  "description": "VajeYar - English vocabulary, reading & exam trainer (IELTS, TOEFL, GRE, PTE, General)",
  "main": "main.js",
  "author": {
    "name": "VajeYar",
    "email": "nahuram7798@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "npm run prepare-app && electron-builder --win portable nsis --x64",
    "dist:portable": "npm run prepare-app && electron-builder --win portable --x64",
    "prepare-app": "node scripts/prepare-app.js",
    "dist:linux-host": "npm run prepare-app && electron-builder --win portable dir --x64 && NSISDIR=$HOME/.cache/electron-builder/nsis/nsis-3.0.4.1 $HOME/.cache/electron-builder/nsis/nsis-3.0.4.1/linux/makensis -V2 -DVERSION=$npm_package_version build/setup-nowine.nsi",
    "dist:win": "npm run prepare-app && electron-builder --win portable nsis --x64 --publish never",
    "dist:mac": "npm run prepare-app && electron-builder --mac dmg zip --universal --publish never",
    "dist:linux": "npm run prepare-app && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.vajeyar.app",
    "productName": "VajeYar",
    "copyright": "VajeYar",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ],
    "afterPack": "./afterPack.js",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "VajeYar-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VajeYar",
      "artifactName": "VajeYar-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-512.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "VajeYar-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "VajeYar-${version}-mac.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon-512.png",
      "category": "Education",
      "synopsis": "English vocabulary & reading trainer",
      "maintainer": "VajeYar <nahuram7798@gmail.com>",
      "artifactName": "VajeYar-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "VajeYar-${version}-linux-amd64.deb"
    }
  },
  "homepage": "https://vajeyar.mohammadfakhari59.workers.dev"
}
